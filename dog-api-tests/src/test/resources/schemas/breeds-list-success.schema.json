{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["message", "status"],
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["success"]
    }
  }
}
