{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["message", "status"],
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "enum": ["success"]
    }
  }
}
