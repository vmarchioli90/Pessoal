{
  "name": "teste-tecnico-qa-agibank",
  "version": "1.0.0",
  "description": "Automação de testes Web, API e performance para o desafio técnico de QA Agibank.",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test",
    "test:headed": "playwright test --headed",
    "test:api": "mvn -f dog-api-tests/pom.xml clean test",
    "test:all": "npm run test:web && npm run test:api",
    "report": "playwright show-report",
    "report:api": "node dog-api-tests/scripts/generate-api-report-pt.js && node scripts/open-report.js dog-api-tests/target/site/api-report-pt/index.html",
    "report:api:allure": "cd dog-api-tests && mvn allure:serve",
    "test:performance:load": "node scripts/run-performance.js load",
    "test:performance:spike": "node scripts/run-performance.js spike",
    "report:performance:load": "node scripts/open-report.js blazedemo-performance-tests/reports/load-test-executive/index.html",
    "report:performance:load:jmeter": "node scripts/open-report.js blazedemo-performance-tests/reports/load-test-report/index.html",
    "report:performance:spike": "node scripts/open-report.js blazedemo-performance-tests/reports/spike-test-executive/index.html",
    "report:performance:spike:jmeter": "node scripts/open-report.js blazedemo-performance-tests/reports/spike-test-report/index.html"
  },
  "keywords": [
    "playwright",
    "qa",
    "automation",
    "blog-do-agi",
    "rest-assured",
    "jmeter"
  ],
  "author": "vmarchioli90",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vmarchioli90/teste-tecnico-qa-agibank.git"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
