{
  "name": "blog-do-agi-playwright-tests",
  "version": "1.0.0",
  "description": "Automacao web da busca de artigos do Blog do Agi com Playwright.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test",
    "test:headed": "playwright test --headed",
    "test:api": "cd dog-api-tests && mvn clean test",
    "test:all": "npm run test:web && npm run test:api",
    "report": "playwright show-report",
    "report:api": "node dog-api-tests\\scripts\\generate-api-report-pt.js && start dog-api-tests\\target\\site\\api-report-pt\\index.html",
    "report:api:allure": "cd dog-api-tests && mvn allure:serve",
    "test:performance:load": "cd blazedemo-performance-tests && scripts\\run-load-test.bat",
    "test:performance:spike": "cd blazedemo-performance-tests && scripts\\run-spike-test.bat",
    "report:performance:load": "node blazedemo-performance-tests\\scripts\\generate-load-report-pt.js && start blazedemo-performance-tests\\reports\\load-test-report-pt\\index.html",
    "report:performance:load:jmeter": "start blazedemo-performance-tests\\reports\\load-test-report\\index.html",
    "report:performance:spike": "start blazedemo-performance-tests\\reports\\spike-test-report\\index.html"
  },
  "keywords": [
    "playwright",
    "qa",
    "automation",
    "blog-do-agi"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.45.0"
  }
}
